# Compiled PDF output
*.pdf
*.gph

# ...but the manuscript figure PDFs are source assets, not build artifacts: keep them
!manuscript/Graphs/*.pdf

# ...and the editor/referee correspondence PDFs are received documents, not build artifacts: keep them
!correspondence/*.pdf

# ...and the compiled Beamer deck plus its source figures are the deliverable, not build artifacts: keep them
!presentation/*.pdf
!presentation/figures/*.pdf

# macOS junk
.DS_Store
